<mxfile host="app.diagrams.net" modified="2026-04-28T00:00:00Z" agent="kube-burner-docs" version="21.0.0" type="device">
  <diagram id="uninstall-001" name="kube-burner Uninstall">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="kube-burner Uninstall — Full Cluster Cleanup" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Remove ALL kube-burner artifacts: Jobs, VMs, namespaces, ClusterRole, ClusterRoleBinding" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#5f6368;" vertex="1" parent="1">
          <mxGeometry x="40" y="54" width="900" height="24" as="geometry" />
        </mxCell>

        <!-- Step 1 -->
        <mxCell id="s1" value="Step 1&#xa;Delete the Job&#xa;kubectl delete job &lt;name&gt; -n &lt;ns&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#d32f2f;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step 2 -->
        <mxCell id="s2" value="Step 2 (VM tests only)&#xa;Delete VMs&#xa;kubectl delete vm -A -l app=&lt;label&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#d32f2f;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="110" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s2" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step 3 -->
        <mxCell id="s3" value="Step 3&#xa;Delete the namespace&#xa;oc delete project &lt;namespace&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#d32f2f;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="110" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="s3" target="s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step 4 -->
        <mxCell id="s4" value="Step 4&#xa;Remove cluster RBAC&#xa;kubectl delete clusterrole kube-burner&#xa;kubectl delete clusterrolebinding kube-burner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#d32f2f;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="880" y="110" width="260" height="70" as="geometry" />
        </mxCell>

        <!-- Verify box -->
        <mxCell id="verify" value="✅ Verify clean — ALL 4 commands must return nothing:&#xa;  oc get projects | grep -E 'burner|perf|bench'&#xa;  kubectl get clusterrole,clusterrolebinding | grep kube-burner&#xa;  kubectl get jobs -A | grep kb-&#xa;  kubectl get vm -A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#188038;fontSize=12;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="700" height="100" as="geometry" />
        </mxCell>

        <!-- Full wipe -->
        <mxCell id="fullwipe" value="🔥 Full wipe (removes all burner- / perf- / bench- namespaces):&#xa;for ns in $(oc get projects --no-headers -o custom-columns=NAME:.metadata.name \&#xa;  | grep -E '^burner-|^perf-|^bench-'); do&#xa;  echo 'Deleting: '$ns&#xa;  oc delete project $ns&#xa;done" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce8e6;strokeColor=#d32f2f;fontSize=12;align=left;" vertex="1" parent="1">
          <mxGeometry x="760" y="220" width="380" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
