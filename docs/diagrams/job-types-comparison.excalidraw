    {"id":"card-read-body","type":"text","x":290,"y":190,"width":200,"height":180,"angle":0,"strokeColor":"#343a40","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":2006,"version":1,"versionNonce":2006,"isDeleted":false,"boundElements":null,"updated":1714000000000,"link":null,"locked":false,"text":"Issues GET requests to the\nAPI server at rate-limited QPS.\n\nNeeds existing objects\n(run after create job).\n\npodLatency: SKIPPED\n(not compatible).\n\nUse for: API read stress,\ncontroller read simulation.\n\nReal: 9s, 3 passes,\n12 objects, QPS=5","fontSize":13,"fontFamily":2,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Issues GET requests to the\nAPI server at rate-limited QPS.\n\nNeeds existing objects\n(run after create job).\n\npodLatency: SKIPPED\n(not compatible).\n\nUse for: API read stress,\ncontroller read simulation.\n\nReal: 9s, 3 passes,\n12 objects, QPS=5","lineHeight":1.25,"autoResize":true},

