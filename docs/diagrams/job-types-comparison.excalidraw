    {"id":"card-create-body","type":"text","x":50,"y":190,"width":200,"height":180,"angle":0,"strokeColor":"#343a40","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"roundness":null,"seed":2003,"version":1,"versionNonce":2003,"isDeleted":false,"boundElements":null,"updated":1714000000000,"link":null,"locked":false,"text":"Creates Kubernetes objects\nfrom Go-template manifests.\n\nSupports: pods, deployments,\nservices, configmaps, CRDs.\n\nAdd churnConfig to loop\ndelete+recreate namespaces.\n\nMeasures podLatency.\n\nReal: 5s, 3 namespaces,\nP99 Ready = 2000ms","fontSize":13,"fontFamily":2,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"Creates Kubernetes objects\nfrom Go-template manifests.\n\nSupports: pods, deployments,\nservices, configmaps, CRDs.\n\nAdd churnConfig to loop\ndelete+recreate namespaces.\n\nMeasures podLatency.\n\nReal: 5s, 3 namespaces,\nP99 Ready = 2000ms","lineHeight":1.25,"autoResize":true},

